{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "node .cursor/hooks/guard-shell.mjs",
        "timeout": 5
      }
    ],
    "beforeReadFile": [
      {
        "command": "node .cursor/hooks/guard-read.mjs",
        "timeout": 5,
        "failClosed": true
      }
    ],
    "stop": [
      {
        "command": "node .cursor/hooks/review-context-change.mjs",
        "timeout": 10
      }
    ]
  }
}
