# Shared env file for a local run. Start agent processes from the repo root
# so they load this file. On any other host, set only the variables listed
# for that process in README.md. Extra variables are ignored.
#
# The two MCP servers do not read this file. They only look at PORT in the
# process environment, and they have defaults.

# Kong key-auth value, sent as the `apikey` header (not Authorization).
# Required: agent-app, billing-support-agent, ticketing-agent, booking-agent.
# Must be non-empty even when the gateway does not check it.
KONG_API_KEY=

# OpenAI-compatible base URL on Kong. No trailing slash.
# Required: billing-support-agent, ticketing-agent, booking-agent.
# Example: https://your-gateway.example.com/llm
KONG_LLM_URL=

# MCP proxy base on Kong. No trailing slash.
# Calls go to {KONG_MCP_URL}/{server}/mcp
# Servers: ticketing-mcp, booking-mcp
# Required: ticketing-agent, booking-agent.
# Example: https://your-gateway.example.com/mcp
KONG_MCP_URL=

# A2A proxy base on Kong. No trailing slash.
# Calls go to {KONG_A2A_URL}/{agent}
# Agents: billing-support-agent, ticketing-agent, booking-agent
# Required: agent-app, billing-support-agent.
# Example: https://your-gateway.example.com/a2a
KONG_A2A_URL=

# Model id the upstream behind Kong expects.
# Used by: billing-support-agent, ticketing-agent, booking-agent.
LLM_MODEL=gpt-4o

# --- optional ---

# Public URL of this process. Sent as X-Reva-Agent-Id.
# Set it on each Kong-calling process when a policy matches the agent by the
# URL Kong uses as that service's upstream. Leave unset for local dev.
# PUBLIC_URL=https://billing-support-agent.example.com

# URL advertised on an A2A agent card.
# Used by: billing-support-agent, ticketing-agent, booking-agent.
# When unset: http://localhost:$PORT/ if PORT is set, otherwise http://localhost:8003/.
# A2A_PUBLIC_URL=http://localhost:8002/

# Listen port, if the host assigns one. Defaults when unset:
#   agent-app                8000  (pass --port; uvicorn's own default)
#   billing-support-agent    8002
#   ticketing-agent          8003
#   booking-agent            8004
#   ticketing-mcp            8005
#   booking-mcp              8006
# PORT=8002

# agent-app logging. DEBUG, INFO, WARNING, ...
LOG_LEVEL=DEBUG

# openai SDK HTTP logging for any process that imports the gateway client.
# https://github.com/openai/openai-python#logging
OPENAI_LOG=debug
