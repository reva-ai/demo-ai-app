# Kong-fronted agentic demo — local / Render env.
# Authorization is enforced by your Kong Cloud plugin calling Reva Trust Gateway.
# This app only sends a user JWT on Authorization and routes every hop through Kong.

# OpenAI-compatible base URL on Kong (no trailing slash).
# Example: https://your-gateway.kongcloud.com/llm
KONG_LLM_URL=

# MCP proxy base on Kong (no trailing slash).
# App calls {KONG_MCP_URL}/{server}/mcp for: billing-mcp, external-mcp
# Example: https://your-gateway.kongcloud.com/mcp
KONG_MCP_URL=

# A2A proxy base on Kong (no trailing slash).
# App calls {KONG_A2A_URL}/{agent} for: ticketing-agent, booking-agent
# Example: https://your-gateway.kongcloud.com/a2a
KONG_A2A_URL=

# Bearer token Kong key-auth expects (`apikey` header — not Authorization).
KONG_API_KEY=

# Model id the upstream behind Kong expects.
LLM_MODEL=gpt-4o
